# Claude API key. Leave empty to run the app in built-in demo mode (no network calls).
ANTHROPIC_API_KEY=

# Force demo mode even when a key is set (used by e2e tests): AI_MODE=mock
# AI_MODE=

# Realtime server. Defaults to ws://<page host>:1234 — set this when the
# y-websocket server lives elsewhere (e.g. wss://realtime.example.com).
# NEXT_PUBLIC_WS_URL=

# Port/host for `npm run ws` (server/ws.mjs)
# WS_PORT=1234
# WS_HOST=0.0.0.0

# ── Payments (optional) ─────────────────────────────────────────────
# Claude is used only when ALL of the keys below are set, and only for signed-in users with free uses or a paid plan.
# Supabase (supabase.com → your project → Project Settings → API). One project serves all of Bhargav's apps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: never share it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Razorpay (dashboard.razorpay.com → Account & Settings → API Keys). Use rzp_test_… keys until KYC is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → add https://YOUR-SITE/api/billing/webhook with events payment.captured and order.paid.
RAZORPAY_WEBHOOK_SECRET=
